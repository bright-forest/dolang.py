?start: equation | predicate | bound_constraint

?equation: double_complementarity | equality | formula

equation_block: _NEWLINE? (equation) (_NEWLINE equation )* _NEWLINE?
complementarity_block: _NEWLINE? (double_complementarity | formula) (_NEWLINE double_complementarity | _NEWLINE formula )* _NEWLINE?
assignment_block: _NEWLINE? assignment (_NEWLINE assignment )* _NEWLINE?
value_block: _NEWLINE? (equation | bound_constraint) (_NEWLINE equation | _NEWLINE bound_constraint)* _NEWLINE?

// Allow bare symbol or indexed variable on LHS of assignment (spec_0.1g)
assignment: (variable | symbol) "=" formula

equality: sum "=" sum 
    | sum "==" sum
!inequality: formula ("<="|"<"|">"|">=") formula
predicate: [quantifier] (equality | inequality)
quantifier: "∀" "t" ","
double_inequality: formula "<=" symbol "<=" formula
    | formula "<=" variable "<=" formula
double_complementarity: formula _PERP double_inequality
bound_constraint: _UPTACK double_inequality


_PERP: "⟂" | "|"
_UPTACK: "⊥"

?formula: sum
?sum: product
    | sum "+" product   -> add
    | sum "-" product   -> sub
?product: atom
    | product "*" atom  -> mul
    | product "/" atom  -> div
?pow: atom _POW atom -> pow

_POW: "^"|"**"

?atom: NUMBER           -> number
        | "-" atom         -> neg
        | pow
        | symbol
        | "(" sum ")"
        | expectation
        | call
        | maximization
        | argmaximization
        | solve_call
        | aggregate_call
        | variable

// Derivative-subscripted names: d_{a}V, d_{h_keep}V, D_{x}V etc.
// Parsed as a single token whose value is the full string "d_{a}V".
// Priority .2 prevents NAME from grabbing the "d" prefix.
DERIV_VAR.2: ("d"|"D") "_{" /[A-Za-z_]\w*/ "}" /[A-Za-z]\w*/

!symbol: NAME -> symbol
       | DERIV_VAR -> symbol

// --- Expectation openers (HIGH priority to prevent NAME from grabbing E_ prefix) ---
_EOPEN.2: "E[" | "𝔼["
_EUSCORE.2: "E_" | "𝔼_"

// helper for the variable list inside { ... }
exp_var_list: NAME ("," NAME)*   -> exp_var_list
cond_exp_var_list: exp_var_list _PERP exp_var_list  -> cond_exp_var_list

// Expectation rule with three forms:
// 1. Bracket form: E[...] or 𝔼[...]
// 2. Subscript form: E_{y,z}(...) or 𝔼_{y,z}(...)
// 3. Legacy function form: E_y(...) - normalized to expectation
expectation: _EOPEN formula "]"                              -> expectation
    | _EUSCORE "{" cond_exp_var_list "}" "(" formula ")"     -> expectation
    | _EUSCORE "{" exp_var_list "}" "(" formula ")"          -> expectation
    | EFUNCTION "(" formula ")"                              -> expectation

// --- Maximization opener (HIGH priority to prevent NAME from grabbing max_ prefix) ---
_MAXUSCORE.2: "max_"

// helper for the variable list inside { ... }
max_var_list: NAME ("," NAME)*   -> max_var_list

// Maximization rule with two forms:
// 1. Subscript form: max_{c}(...) or max_{c,a}(...)
// 2. Legacy brace form: max_c{...} - normalized to maximization
maximization: _MAXUSCORE "{" max_var_list "}" "(" formula ("," formula)* ")"  -> maximization
    | MAXIMIZE "{" formula "}"                                  -> maximization

// --- Argmax opener (HIGH priority to prevent NAME from grabbing argmax_ prefix) ---
_ARGMAXUSCORE.2: "argmax_"

// Argmax rule with two forms:
// 1. Subscript form: argmax_{c}(...) or argmax_{c,a}(...)
// 2. Legacy brace form: argmax_c{...} - normalized to argmaximization
argmaximization: _ARGMAXUSCORE "{" max_var_list "}" "(" formula ")"  -> argmaximization
    | ARGMAXIMIZE "{" formula "}"                                    -> argmaximization

// --- Solve operator (implicit system: solve_{c[>], h[>]}{eq1, eq2}) ---
_SOLVEUSCORE.2: "solve_"

// The solve-for list accepts variables with perch tags (not bare names)
solve_var_list: variable ("," variable)*   -> solve_var_list

// Conditions are equalities or formulas, separated by commas.
// Newlines inside the braces are allowed (treated as whitespace).
solve_eq_list: _NL? equation (_NL? "," _NL? equation)* _NL?    -> solve_eq_list

_NL: NEWLINE+

solve_call: _SOLVEUSCORE "{" solve_var_list "}" "{" solve_eq_list "}"  -> solve_call

// --- Aggregate binder (e.g. AGGREGATE_d(expr; params)) ---
AGG_HEAD.2: /AGGREGATE_[A-Za-z_]\w*/
aggregate_call: AGG_HEAD "(" sum (";" sum)* ")"

variable: cname  "[" date_index "]" "[" NAME "]" -> variable
        | cname  "[" date_index "]" -> variable
        | cname "[" "t" "]" -> variable
        | cname "(" date_index ")" -> variable
        | cname "[" "t$" subperiod "]"
subperiod: INT | NAME
!cname: NAME -> name
      | DERIV_VAR -> name
?date_index: "t" SIGNED_INT2 -> date
    | SIGNED_INT -> date
    | PERCH_TAG -> date
// Function calls: built-in names + any user-defined NAME(...)
// User functions are validated at compile time, not parse time.
?call: FUNCTION "(" sum ("," sum)* ")" -> call
     | NAME "(" sum ("," sum)* ")"     -> call
FUNCTION: "sin"|"cos"|"exp"|"log"|"abs"|"sqrt"|"sign"|"min"|"max"|"floor"|"ceil"
EFUNCTION: /E_[A-Za-z][A-Za-z0-9_]*/
MAXIMIZE: /max_[A-Za-z][A-Za-z0-9_]*/
ARGMAXIMIZE: /argmax_[A-Za-z][A-Za-z0-9_]*/
PERCH_TAG: /_[A-Za-z][A-Za-z0-9_]*/

SIGNED_INT2: ("+"|"-") INT

_NEWLINE: NEWLINE
UNICODE_LETTER: /[^\W\d_\$]/
NAME: UNICODE_LETTER ("_"|UNICODE_LETTER|DIGIT)*
%import common.SIGNED_INT
%import common.DIGIT
%import common.INT
%import common.NUMBER
%import common.WS_INLINE
%import common.NEWLINE
%ignore WS_INLINE
